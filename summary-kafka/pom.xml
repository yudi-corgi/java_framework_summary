<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>allframework</artifactId>
        <groupId>com.demo</groupId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>summary-kafka</artifactId>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <kafka.version>3.9.1</kafka.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-streams</artifactId>
            <version>${kafka.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <scm>
        <!-- 假设你的 Git 仓库地址是这个，请替换成你实际的地址 -->
        <!-- connection 是只读连接，developerConnection 是读写连接 -->
        <connection>scm:git:git@github.com:yudi-corgi/java_framework_summary.git</connection>
        <developerConnection>scm:git:git@github.com:yudi-corgi/java_framework_summary.git</developerConnection>
        <!-- url 是你的项目在 Git 仓库的 Web 浏览地址 -->
        <url>https://github.com/yudi-corgi/java_framework_summary</url>
        <!-- tag 告诉 release 插件当前 HEAD 是什么，它会基于此创建新 tag -->
        <tag>HEAD</tag>
    </scm>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>3.0.1</version>
                <configuration>
                    <!-- release:perform 阶段执行的目标 -->
                    <goals>clean package</goals>
                    <!-- 确保所有子模块版本都被处理 -->
                    <autoVersionSubmodules>true</autoVersionSubmodules>
                    <!-- 默认 true，是否在 release:prepare 阶段自动推送到远程 Git 仓库 -->
                    <pushChanges>false</pushChanges>
                    <!-- 自定义生成的 Git 标签 -->
                    <tagNameFormat>v@{project.version}</tagNameFormat>
                    <!-- 传递给 Maven 的构建参数 -->
                    <arguments>-DskipTests</arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>